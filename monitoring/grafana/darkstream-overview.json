{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "darkstream_jobs_queue_depth", "legendFormat": "queue depth", "refId": "A" }],
      "title": "Queue depth (pending jobs)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "darkstream_jobs_in_progress", "legendFormat": "in progress", "refId": "A" }],
      "title": "Jobs in progress",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "darkstream_workers_active", "legendFormat": "active", "refId": "A" }, { "expr": "darkstream_workers_registered", "legendFormat": "registered", "refId": "B" }],
      "title": "Workers (active / registered)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(darkstream_jobs_duration_seconds_bucket{status=\"completed\"}[$__rate_interval])))", "legendFormat": "p95 duration", "refId": "A" }],
      "title": "Job duration p95 (completed)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum by (status) (rate(darkstream_jobs_total[$__rate_interval]))", "legendFormat": "{{status}}", "refId": "A" }],
      "title": "Job throughput by status (jobs/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum by (reason) (rate(darkstream_jobs_retries_total[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A" }, { "expr": "sum by (error_type) (rate(darkstream_jobs_errors_total[$__rate_interval]))", "legendFormat": "error: {{error_type}}", "refId": "B" }],
      "title": "Retries and errors (per second)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "darkstream_workers_active", "legendFormat": "active", "refId": "A" }, { "expr": "darkstream_workers_registered", "legendFormat": "registered", "refId": "B" }],
      "title": "Workers over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 9,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "time() - darkstream_workers_last_heartbeat_timestamp", "legendFormat": "{{worker_id}} ({{hostname}})", "refId": "A" }],
      "title": "Worker heartbeat age (seconds)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 10,
      "options": { "legend": { "calcs": ["rate"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "rate(darkstream_transfer_bytes_downloaded_total[$__rate_interval])", "legendFormat": "downloaded", "refId": "A" }, { "expr": "rate(darkstream_transfer_bytes_uploaded_total[$__rate_interval])", "legendFormat": "uploaded", "refId": "B" }],
      "title": "Transfer throughput (bytes/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 11,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, direction) (rate(darkstream_transfer_speed_bytes_per_second_bucket[$__rate_interval])))", "legendFormat": "p95 {{direction}}", "refId": "A" }],
      "title": "Transfer speed p95 (bandwidth-limited uploads/downloads)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 12,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum by (endpoint, method, status) (rate(darkstream_api_requests_total[$__rate_interval]))", "legendFormat": "{{method}} {{endpoint}} {{status}}", "refId": "A" }],
      "title": "API requests by endpoint (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "id": 13,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(darkstream_api_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{endpoint}}", "refId": "A" }],
      "title": "API latency p95 by endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "id": 14,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, location) (rate(darkstream_scanner_scan_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{location}}", "refId": "A" }],
      "title": "Scan duration p95 per location",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "id": 15,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum by (location, outcome) (rate(darkstream_scanner_files_total[$__rate_interval]))", "legendFormat": "{{location}} {{outcome}}", "refId": "A" }],
      "title": "Scan outcomes per second (hashed / skipped / non_video)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "id": 16,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum by (status) (darkstream_jobs_total)", "legendFormat": "{{status}}", "refId": "A" }],
      "title": "Total jobs by status (cumulative)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["darkstream"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "DarkStream Overview",
  "uid": "darkstream-overview",
  "version": 1,
  "weekStart": ""
}
